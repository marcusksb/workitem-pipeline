#!/usr/bin/env python3
"""PreToolUse hook of planning sessions: file edits are only allowed in the workitems folder.

A planning session may create workitems but never changes code, also not after its plan was
approved. Gets the tool call as JSON on stdin; exit 2 refuses it and tells Claude why. Does
nothing outside a planning session (no WORKITEM_PLAN). Needs WORKITEM_REPO.
"""
import json
import os
import sys
from pathlib import Path

sys.dont_write_bytecode = True
from workitem_paths import workitems_dir

if not os.environ.get("WORKITEM_PLAN"):
    sys.exit(0)
repo = os.environ.get("WORKITEM_REPO")
call = json.load(sys.stdin)
tool_input = call.get("tool_input") or {}
target = tool_input.get("file_path") or tool_input.get("notebook_path")
if not target or not repo:
    sys.exit(0)

allowed = workitems_dir(repo).resolve()
path = Path(call.get("cwd") or repo, target).resolve()
if path == allowed or allowed in path.parents:
    sys.exit(0)
print(
    f"This is a planning session: it does not change code. Edits are only allowed under {allowed}. "
    "Save a plan with workitem-plan-note --plan, or create a workitem for the change.",
    file=sys.stderr,
)
sys.exit(2)
