#!/usr/bin/env python3
"""Notification hook for workitem and planning tmux sessions.

Runs when a `wi-*` session waits for input (question, permission or trust
prompt). If the workitem is still `working`, marks it blocked; the UI
alerts the browser. An agent that set `waiting: <what>` idles on purpose, so
only a prompt that needs a human (permission, elicitation) blocks it. Does
nothing outside such a session or when the agent set another status itself.
Needs WORKITEM and WORKITEM_FILE in the env.
In a planning session (WORKITEM_PLAN, the plan record) it sets the
record's `status: working` to `waiting` instead.
In a create session (WORKITEM_CREATE, its tmux session name) it sets the
session option `@workitem_waiting`, which the UI shows on the session's toast;
`--resume` (run when the agent goes on) unsets it.
"""
import json
import os
import re
import subprocess
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from workitem_fields import update_file  # noqa: E402

def unquote(value):
    """An agent may quote a value (`"waiting: CI"`) because it holds a colon."""
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
        return value[1:-1]
    return value


def replace_status(path, key, matches, new):
    """Sets `key` to `new` while its value matches, checked again on every reread."""
    def change(text):
        status = re.search(rf"^{key}:\s*(.*)$", text, re.M)
        if not status or not matches(unquote(status.group(1).strip())):
            return None
        return text[:status.start()] + f"{key}: {new}" + text[status.end():]
    try:
        update_file(path, change)
    except (OSError, RuntimeError):
        return


create = os.environ.get("WORKITEM_CREATE")
if create:
    # tmux finds the UI's server through the inherited $TMUX, also with a custom socket.
    unset = ["-u"] if "--resume" in sys.argv[1:] else []
    value = [] if unset else ["1"]
    try:
        subprocess.run(["tmux", "set-option", *unset, "-t", f"={create}:", "@workitem_waiting", *value],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    except OSError:
        pass
    sys.exit(0)

plan = os.environ.get("WORKITEM_PLAN")
if plan:
    replace_status(plan, "status", lambda s: s == "working", "waiting")
    sys.exit(0)

name, file = os.environ.get("WORKITEM"), os.environ.get("WORKITEM_FILE")
if not name or not file:
    sys.exit(0)

try:
    kind = json.load(sys.stdin).get("notification_type", "")
except (ValueError, AttributeError):
    kind = ""
needs_human = kind in ("permission_prompt", "elicitation_dialog", "elicitation_url_dialog")
replace_status(file, "agent_status", lambda s: s == "working" or (needs_human and s.startswith("waiting")),
               f"blocked: waiting for input, tmux attach -t wi-{name}")
