#!/usr/bin/env python3
"""Notification hook for workitem and planning tmux sessions.

Runs when a `wi-*` session waits for input (question, permission or trust
prompt). If the workitem is still `working`, marks it blocked; the UI
alerts the browser. An agent that set `waiting: <what>` idles on purpose, so
only a prompt that needs a human (permission, elicitation) blocks it. Does
nothing outside such a session or when the agent set another status itself.
Needs WORKITEM and WORKITEM_REPO in the env.
In a planning session (WORKITEM_PLAN, the plan record) it sets the
record's `status: working` to `waiting` instead.
"""
import json
import os
import re
import sys
from pathlib import Path

sys.dont_write_bytecode = True
from workitem_paths import workitems_dir


def unquote(value):
    """An agent may quote a value (`"waiting: CI"`) because it holds a colon."""
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
        return value[1:-1]
    return value


def replace_status(path, key, matches, new):
    try:
        text = path.read_text()
    except OSError:
        return
    status = re.search(rf"^{key}:\s*(.*)$", text, re.M)
    if not status or not matches(unquote(status.group(1).strip())):
        return
    path.write_text(text[:status.start()] + f"{key}: {new}" + text[status.end():])


plan = os.environ.get("WORKITEM_PLAN")
if plan:
    replace_status(Path(plan), "status", lambda s: s == "working", "waiting")
    sys.exit(0)

name, repo = os.environ.get("WORKITEM"), os.environ.get("WORKITEM_REPO")
if not name or not repo:
    sys.exit(0)

try:
    kind = json.load(sys.stdin).get("notification_type", "")
except (ValueError, AttributeError):
    kind = ""
needs_human = kind in ("permission_prompt", "elicitation_dialog", "elicitation_url_dialog")
path = workitems_dir(repo) / name / "workitem.md"
replace_status(path, "agent_status", lambda s: s == "working" or (needs_human and s.startswith("waiting")),
               f"blocked: waiting for input, tmux attach -t wi-{name}")
