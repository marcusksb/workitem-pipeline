#!/usr/bin/env python3
"""Move a workitem between pipeline stages.

  workitem-move <workitem-dir|workitem.md> <stage>
  workitem-move <workitem-dir|workitem.md> --board <name>   # put it on that board's entry stage

The item is a path (absolute or relative to the current directory) inside a workspace folder.
Rules come from the item's board, <workspace>/boards/<name>.json, which `board: <name>` in the
item's frontmatter names. Exit code 1 means the move was refused.
"""
import json
import os
import re
import subprocess
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from workitem_fields import set_fields  # noqa: E402

BOARD_NAME = re.compile(r"[A-Za-z0-9_-]+")
FRONTMATTER = re.compile(r"\A---\n(.*?)\n---\n", re.S)


def fail(message):
    print(f"refused: {message}", file=sys.stderr)
    sys.exit(1)


def strings(value):
    return isinstance(value, list) and all(isinstance(x, str) for x in value)


def problems(config):
    """Why `config` cannot be used as a board, as a list of messages (empty when it can).
    The backend (`Pipeline::parse`) rejects the same files; testdata/boards holds both sides' cases."""
    if not isinstance(config, dict):
        return ["the board must be a JSON object"]
    stages = config.get("stages")
    if not isinstance(stages, list) or not all(isinstance(s, dict) for s in stages):
        return ["'stages' must be a list of objects"]
    names = [s.get("name") for s in stages]
    if not all(isinstance(n, str) and n for n in names):
        return ["every stage needs a 'name'"]
    found = []
    if len(set(names)) != len(names):
        found.append("stage names must be unique")
    if config.get("entry") not in names:
        found.append(f"'entry' ({config.get('entry')!r}) is not a stage")
    for stage in stages:
        name = stage["name"]
        targets = stage.get("next", [])
        if not strings(targets):
            found.append(f"'{name}' has next {targets!r}, which must be a list of stage names")
            targets = []
        for target in targets:
            if target not in names:
                found.append(f"'{name}' has next '{target}', which is not a stage")
        # Only moves listed in `next` are allowed, so a gate or on_merge target outside it could never work.
        gate = stage.get("gate")
        if gate is not None and not (isinstance(gate, dict) and all(isinstance(gate.get(k), str) for k in ("label", "approve_to", "reject_to"))):
            found.append(f"'{name}' has gate {gate!r}, which needs a label, approve_to and reject_to")
            gate = None
        moves = [(key, gate[key]) for key in ("approve_to", "reject_to")] if gate else []
        if stage.get("on_merge") is not None:
            moves.append(("on_merge", stage["on_merge"]))
        for key, target in moves:
            if target not in targets:
                found.append(f"'{name}' has {key} {target!r}, which is not in its next")
        limit = stage.get("limit")
        if limit is not None and not (type(limit) is int and limit > 0):
            found.append(f"'{name}' has limit {limit!r}, which must be a whole number above 0")
        for key in ("require", "on_enter"):
            value = stage.get(key, {})
            if not (isinstance(value, dict) and all(isinstance(v, str) for v in value.values())):
                found.append(f"'{name}' has {key} {value!r}, which must be an object of strings")
        states = stage.get("issue_state")
        if states is not None and not (isinstance(states, list) and states and all(isinstance(x, str) and x for x in states)):
            found.append(f"'{name}' has issue_state {states!r}, which must be a list of state names")
    if not strings(config.get("brief_sections")):
        found.append("'brief_sections' must be a list of section names")
    # A board without a repo (an intake board that writes no code) is valid; a given one must exist.
    repo = config.get("repo")
    if "repo" in config and not (isinstance(repo, str) and Path(repo).expanduser().is_absolute() and Path(repo).expanduser().is_dir()):
        found.append(f"'repo' ({repo!r}) must be an absolute path to a directory")
    return found


def board_file(workspace, name):
    """The file of board `name` in `workspace`, or None when there is none."""
    if not BOARD_NAME.fullmatch(name or ""):
        return None
    own = Path(workspace, "boards", f"{name}.json")
    return own if own.is_file() else None


def load_board(workspace, name):
    """The stage table of board `name`, with `entry` and `brief_sections`; refuses a missing or invalid file."""
    if not name:
        fail("the item has no 'board:'")
    source = board_file(workspace, name)
    if not source:
        fail(f"board '{name}' has no file in {workspace}/boards")
    try:
        config = json.loads(source.read_text())
    except ValueError as error:
        fail(f"{source} is not valid JSON: {error}")
    found = problems(config)
    if found:
        fail(f"{source} is invalid: {'; '.join(found)}")
    config["stages"] = {stage["name"]: stage for stage in config["stages"]}
    return config


def read(path):
    text = path.read_text()
    match = FRONTMATTER.match(text)
    if not match:
        fail(f"{path} has no frontmatter")
    fields = {}
    for line in match.group(1).splitlines():
        key, sep, value = line.partition(":")
        if sep:
            fields[key.strip()] = value.strip()
    return text, match, fields


def brief_problems(text, sections):
    match = re.search(r"^## Review brief\s*$(.*?)(?=^## |\Z)", text, re.M | re.S)
    if not match:
        return ["missing '## Review brief' section"]
    body = match.group(1)
    problems = []
    for section in sections:
        part = re.search(rf"^### {re.escape(section)}\s*$(.*?)(?=^### |\Z)", body, re.M | re.S)
        if not part or not part.group(1).strip():
            problems.append(f"review brief section '### {section}' is missing or empty")
    return problems


def requirement_problem(key, wanted, fields, text, sections, path):
    """Why `require: {key: wanted}` is not met, or None. `issue: linked`, `brief: complete`,
    `depends_on: merged` and `children: merged` are checks; anything else compares a frontmatter value."""
    if (key, wanted) == ("issue", "linked"):
        if fields.get("issue", "none").lower() in ("", "none"):
            return "a linked issue (issue: is 'none')"
    elif (key, wanted) == ("brief", "complete"):
        missing = brief_problems(text, sections)
        if missing:
            return "a complete review brief: " + "; ".join(missing)
    elif (key, wanted) == ("depends_on", "merged"):
        waiting = [d for d in dependencies(fields) if not merged(path.parent.parent, d)]
        if waiting:
            return "these dependencies merged first: " + ", ".join(waiting)
    elif (key, wanted) == ("children", "merged"):
        kids = children(path)
        waiting = [d for d in kids if not merged(path.parent.parent, d)]
        if not kids:
            return "children (no item has parent: " + path.parent.name + ")"
        if waiting:
            return "these children merged first: " + ", ".join(waiting)
    elif fields.get(key) != wanted:
        return f"{key}: {wanted} (is '{fields.get(key)}')"
    return None


def children(path):
    """Dirs of the items of the workspace whose `parent:` is the item at `path`, sorted."""
    return sorted(
        other.parent.name
        for other in path.parent.parent.glob("*/workitem.md")
        if other != path and read(other)[2].get("parent") == path.parent.name
    )


def dependencies(fields):
    return [d.strip() for d in fields.get("depends_on", "").split(",") if d.strip()]


def merged(workspace, name):
    """Whether item `name` of the workspace is merged: its PR is, or it sits in its board's
    `on_merge` stage. A dependency that is gone counts as merged (Clear removes done items)."""
    path = Path(workspace, name, "workitem.md")
    if "/" in name or not path.is_file():
        return True
    _, _, fields = read(path)
    if fields.get("pr_state") == "merged":
        return True
    source = board_file(workspace, fields.get("board"))
    if not source:
        return False
    try:
        board = json.loads(source.read_text())
        return any(s.get("on_merge") and fields.get("stage") == s.get("on_merge") for s in board.get("stages", []))
    except (ValueError, AttributeError):
        return False


def resolve(target):
    path = Path(target)
    return path / "workitem.md" if path.is_dir() else path


def move(target, stage):
    path = resolve(target)
    text, _, fields = read(path)
    board = load_board(path.parent.parent, fields.get("board"))
    stages = board["stages"]
    current = fields.get("stage")
    if stage not in stages:
        fail(f"unknown stage '{stage}'")
    if current in stages:
        if stage not in stages[current].get("next", []):
            fail(f"'{current}' -> '{stage}' is not allowed (allowed: {', '.join(stages[current].get('next', [])) or 'none'})")
    elif stage != board["entry"]:
        fail(f"current stage '{current}' is not on this board; it can only move to '{board['entry']}'")
    enter(path, text, fields, board, stage)
    print(f"{path.parent.name}: {current} -> {stage}")


def holding(path, board, stage):
    """How many other items of `board` are in `stage`, among the siblings of `path`."""
    count = 0
    for other in path.parent.parent.glob("*/workitem.md"):
        if other != path:
            _, _, fields = read(other)
            count += fields.get("stage") == stage and fields.get("board") == board
    return count

def enter(path, text, fields, board, stage, extra=None):
    """Checks `require` for `stage`, then writes the stage, `ok`, `on_enter` and any `extra` fields."""
    stages = board["stages"]
    limit = stages[stage].get("limit")
    if limit is not None and fields.get("stage") != stage:
        name = (extra or {}).get("board", fields.get("board"))
        if holding(path, name, stage) >= limit:
            fail(f"'{stage}' is full (limit {limit})")
    for key, wanted in stages[stage].get("require", {}).items():
        unmet = requirement_problem(key, wanted, fields, text, board["brief_sections"], path)
        if unmet:
            fail(f"'{stage}' requires {unmet}")
    # A new stage starts its handler's attempts over (see watch/run-items).
    set_fields(path, {"stage": stage, "agent_status": "ok", "handler_attempts": None,
                      **stages[stage].get("on_enter", {}), **(extra or {})})
    if stages[stage].get("issue_state"):
        move_issue(path, stages[stage]["issue_state"])


def move_issue(path, states):
    """Moves the item's issue to the stage's `issue_state` (decision 72). Best effort: the stage
    move stands whatever the tracker says, and `workitem-issue` explains what it skipped or why it failed."""
    script = Path(os.path.realpath(__file__)).with_name("workitem-issue")
    try:
        result = subprocess.run([sys.executable, str(script), "set-state", str(path), *states], capture_output=True, text=True, timeout=120)
    except subprocess.TimeoutExpired:
        print(f"warning: the issue of {path.parent.name} was not moved: workitem-issue timed out", file=sys.stderr)
        return
    if result.stdout.strip():
        print(result.stdout.strip())
    if result.stderr.strip():
        print(f"warning: {result.stderr.strip()}" if result.returncode else result.stderr.strip(), file=sys.stderr)


def has_session(name):
    command = ["tmux"]
    if os.environ.get("WORKITEM_UI_TMUX_SOCKET"):
        command += ["-L", os.environ["WORKITEM_UI_TMUX_SOCKET"]]
    try:
        return subprocess.run([*command, "has-session", "-t", f"={name}"], capture_output=True).returncode == 0
    except FileNotFoundError:  # no tmux, so no session
        return False


def switch(target, name):
    """Puts the item on board `name`, at that board's entry stage."""
    path = resolve(target)
    text, _, fields = read(path)
    if has_session(f"wi-{path.parent.name}"):
        fail(f"{path.parent.name} has a running session (wi-{path.parent.name}); end it first")
    board = load_board(path.parent.parent, name)
    enter(path, text, fields, board, board["entry"], {"board": name})
    print(f"{path.parent.name}: board {fields.get('board', '-')} -> {name}, stage {board['entry']}")


args = sys.argv[1:]
if len(args) == 3 and args[1] == "--board":
    switch(args[0], args[2])
elif len(args) == 2:
    move(*args)
else:
    print(__doc__, file=sys.stderr)
    sys.exit(2)
