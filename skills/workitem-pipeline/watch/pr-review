#!/usr/bin/env python3
"""Column watcher for the PR stage: react to the PR facts that watch/pr-status wrote.

  pr-review [--max-attempts 3]

Reads only the items' frontmatter, never GitHub. For each item with a PR link, at most one of:
  - pr_state merged: move it to WORKITEM_ON_MERGE; closed: block it;
  - pr_merge conflicting: start the conflict fixer, once per PR head;
  - pr_ci_fix failing: start the CI fixer, once per PR head and at most --max-attempts times
    per red streak (pr_fix_attempts);
  - pr_unseen_comments: start the comments fixer and move the ids into pr_seen_comments.
Fixers only start for an idle item (ok, no session). A fixer is remembered as pr_fixing; when its
session is gone the script stamps pr_fix_ended_at and waits until pr-status read the PR after it
(pr_checked_at), so it never acts on what it read before the fixer pushed. A CI or conflict fixer
whose head is still red or conflicting then pushed nothing, and the item is blocked. While an
item is blocked its heads and attempts are forgotten, so clearing the block tries again.
"""
import json, os, subprocess, sys
from datetime import datetime, timezone

sys.dont_write_bytecode = True
# The helpers sit next to workitem-move, which the backend names.
sys.path.insert(0, os.path.dirname(os.environ["WORKITEM_MOVE"]) if "WORKITEM_MOVE" in os.environ
                else os.path.join(os.path.dirname(os.path.realpath(__file__)), "../bin"))
from workitem_fields import read_fields, set_fields  # noqa: E402

FORGOTTEN_WHILE_BLOCKED = ("pr_conflict_head", "pr_ci_head", "pr_fix_attempts")


def unquote(value):
    for q in ('"', "'"):
        if len(value) >= 2 and value[0] == q and value[-1] == q:
            return value[1:-1]
    return value


def id_list(value):
    return [i for i in (value or "").split(",") if i]


def now():
    """UTC with milliseconds; pr-status and pr-review compare these as text."""
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def decide(fields, busy, max_attempts, stamp):
    """What to do for one item: (updates, action). `action` is None, ("move",), or
    ("fix", kind); updates are frontmatter keys to write (None removes one). Pure, for tests."""
    status = unquote(fields.get("agent_status") or "ok")
    state = fields.get("pr_state")
    if state == "merged":
        return {}, ("move",)
    if state == "closed":
        blocked = status.startswith("blocked") or busy
        return ({} if blocked else {"agent_status": "blocked: PR was closed without merge"}), None
    if state != "open":
        return {}, None
    if status.startswith("blocked"):
        return {k: None for k in FORGOTTEN_WHILE_BLOCKED if k in fields}, None
    if busy or status != "ok":
        return {}, None
    if fields.get("pr_fixing"):
        return {"pr_fixing": None, "pr_fix_ended_at": stamp}, None
    ended = fields.get("pr_fix_ended_at", "")
    if ended and fields.get("pr_checked_at", "") <= ended:
        return {}, None

    head, ci = fields.get("pr_head", ""), fields.get("pr_ci_fix")
    attempts = int(fields.get("pr_fix_attempts") or 0)
    updates = {}
    if ci in ("passing", "none"):
        updates = {k: None for k in ("pr_fix_attempts", "pr_ci_head") if k in fields}

    # A conflicting PR gets no merge ref, so its checks come back cancelled or stale: the
    # conflict goes first, and comments after it, since fixing them on a stale base would
    # conflict again.
    if fields.get("pr_merge") == "conflicting" and head:
        if fields.get("pr_conflict_head") == head:
            return {"agent_status": "blocked: merge conflict still open after the conflict fixer; rebase by hand, or clear to retry",
                    "pr_conflict_head": None}, None
        # The rebase starts a new CI streak.
        return {"pr_conflict_head": head, "pr_fix_attempts": None, "pr_fixing": "conflict"}, ("fix", "conflict")
    if ci == "failing":
        if head and fields.get("pr_ci_head") == head:
            return {"agent_status": "blocked: CI still failing and the CI fixer pushed nothing; fix by hand, or clear to retry",
                    "pr_ci_head": None}, None
        if attempts >= max_attempts:
            return {"agent_status": f"blocked: CI still failing after {max_attempts} fix attempts"}, None
        return {"pr_ci_head": head, "pr_fix_attempts": str(attempts + 1), "pr_fixing": "ci"}, ("fix", "ci")

    seen = id_list(fields.get("pr_seen_comments"))
    # pr-status may have written the list just before the last fixer took it.
    unseen = [c for c in id_list(fields.get("pr_unseen_comments")) if c not in seen]
    if unseen:
        return {**updates, "pr_seen_comments": ",".join(seen + unseen), "pr_unseen_comments": "", "pr_fixing": "comments"}, ("fix", "comments")
    return updates, None


class Watcher:
    def __init__(self, max_attempts):
        self.max_attempts = max_attempts
        self.on_merge = os.environ.get("WORKITEM_ON_MERGE", "")
        self.busy = set(filter(None, os.environ.get("WORKITEM_BUSY", "").split(",")))
        self.root = os.environ["WORKITEM_DIR_ROOT"]
        self.move = os.environ["WORKITEM_MOVE"]
        self.run_item = os.path.join(os.path.dirname(self.move), "workitem-run-item")

    def fixer(self, name, kind):
        """Starts the fixer; False when the backend refused (no session, item not idle, ...)."""
        result = subprocess.run([self.run_item, name, "--fix", kind], capture_output=True, text=True, env=os.environ)
        if result.returncode != 0:
            print(f"cannot start the {kind} fixer of {name}: {result.stderr.strip()}", file=sys.stderr)
        return result.returncode == 0

    def check(self, item):
        name = item["dir"]
        path = os.path.join(self.root, name, "workitem.md")
        updates, action = decide(read_fields(path), name in self.busy, self.max_attempts, now())
        if action == ("move",):
            if self.on_merge:
                subprocess.run([sys.executable, self.move, path, self.on_merge], capture_output=True)
            return
        if action and not self.fixer(name, action[1]):
            return
        set_fields(path, updates)


def main(argv):
    max_attempts = 3
    while argv:
        flag = argv.pop(0)
        if flag == "--max-attempts":
            max_attempts = int(argv.pop(0))
        elif flag == "--ignore":
            argv.pop(0)  # moved to pr-status; accepted so older boards still run
        else:
            sys.exit(f"unknown option {flag}")
    watcher = Watcher(max_attempts)
    for item in json.load(sys.stdin):
        if item["pr"].startswith("http"):
            watcher.check(item)


if __name__ == "__main__":
    main(sys.argv[1:])
