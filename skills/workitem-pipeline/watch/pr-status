#!/usr/bin/env python3
"""Board watcher: read the PR of every item with gh and write what it found into the item.

  pr-status [--ignore dockerized,e2e,playwright]

For each item on stdin with a PR link whose PR is not already recorded as merged (a closed one
can be reopened, so it is still read), it writes these frontmatter keys, only when they change:
  pr_url              the link it read; a different `pr:` clears every pr_* key first
  pr_state            open | merged | closed
  pr_ci               passing | failing | pending | none, over every check (the board's chip)
  pr_ci_fix           the same without checks whose name contains an --ignore word (the CI fixer)
  pr_ci_failed        names of the red checks
  pr_ci_required      passing | failing | pending | none, over the required checks only (pr-remind)
  pr_merge            mergeable | conflicting | unknown
  pr_approval         approved | changes_requested | review_required | none
  pr_approved_by_me   true | false
  pr_draft            true | false
  pr_head             commit the PR head points to
  pr_head_at          when it first saw that head (UTC), so a script can wait until pushes settle
  pr_activity_at      the latest of: PR opened, last commit, human review, human comment; bots and
                      pr-remind's own comments do not count (pr-remind)
  pr_unseen_comments  ids of comments that ask for a change and are not in pr_seen_comments
  pr_updated_at       GitHub's updatedAt of the PR; inline review comments are read only when it moves
  pr_checked_at       when it read the PR (UTC): with every change, and on every reading while
                      pr-review waits for one newer than pr_fix_ended_at. Not on every run:
                      agents that read the file are told about each write.
The first reading of an item puts the comments already there into pr_seen_comments, so only new
ones are unseen. It starts nothing; watch/pr-review reacts to these keys.

It reads every PR of a repo in one GraphQL query per CHUNK PRs: GitHub charges a query by the
connections it asks for, not per PR, so a whole board costs about a point a run. Review threads
are the expensive part (a connection per thread), hence the second query only for moved PRs.
"""
import json, os, subprocess, sys, time
from datetime import datetime, timezone

sys.dont_write_bytecode = True
# The helpers sit next to workitem-move, which the backend names.
sys.path.insert(0, os.path.dirname(os.environ["WORKITEM_MOVE"]) if "WORKITEM_MOVE" in os.environ
                else os.path.join(os.path.dirname(os.path.realpath(__file__)), "../bin"))
from workitem_fields import read_fields, set_fields  # noqa: E402

FAILED = ("FAILURE", "ERROR", "TIMED_OUT", "CANCELLED", "ACTION_REQUIRED", "STARTUP_FAILURE")
PENDING = ("IN_PROGRESS", "QUEUED", "PENDING", "WAITING", "REQUESTED", "EXPECTED")
REMIND_MARKER = "<!-- pr-remind -->"
# NUMBER is the PR's number; isRequired needs it.
PULL_FIELDS = """number state isDraft mergeable reviewDecision headRefOid createdAt updatedAt
  commits(last: 1) { nodes { commit { committedDate statusCheckRollup { contexts(first: 100) { nodes {
    ... on CheckRun { name status conclusion isRequired(pullRequestNumber: NUMBER) }
    ... on StatusContext { context state isRequired(pullRequestNumber: NUMBER) }
  } } } } } }
  comments(last: 100) { nodes { id createdAt body author { __typename login } } }
  reviews(last: 100) { nodes { id state submittedAt body author { __typename login } } }"""
THREAD_FIELDS = """reviewThreads(first: 100) { nodes { comments(first: 100) { nodes {
  databaseId body author { login } replyTo { databaseId } } } } }"""
CHUNK = 25
UNKNOWN_RETRIES = 3
UNKNOWN_RETRY_WAIT = 2


def check_name(check):
    return check.get("name") or check.get("context") or ""


def result_of(check):
    for key in ("conclusion", "state", "status"):
        if check.get(key):
            return check[key]
    return ""


def ci_of(checks, ignore=()):
    """passing, failing, pending or none. Pending wins, so a fixer never races running checks."""
    seen = pending = failing = False
    for check in checks or []:
        if any(word in check_name(check).lower() for word in ignore):
            continue
        seen = True
        result = result_of(check)
        if result in PENDING:
            pending = True
        elif result in FAILED:
            failing = True
    if not seen:
        return "none"
    return "pending" if pending else "failing" if failing else "passing"


def failed_checks(checks):
    names = []
    for check in checks or []:
        if result_of(check) in FAILED and check_name(check) not in names:
            names.append(check_name(check))
    return names


def is_bot(author):
    login = (author or {}).get("login") or ""
    return (author or {}).get("__typename") == "Bot" or login.endswith("[bot]")


def activity_of(pull):
    """The latest human sign of life on the PR (a node of PULL_FIELDS)."""
    times = [pull.get("createdAt") or ""]
    times += [n["commit"]["committedDate"] for n in pull["commits"]["nodes"]]
    for kind, at in (("comments", "createdAt"), ("reviews", "submittedAt")):
        times += [n.get(at) or "" for n in pull[kind]["nodes"]
                  if n.get("author") and not is_bot(n["author"]) and REMIND_MARKER not in (n.get("body") or "")]
    return max(times, key=parse_time)


def parse_time(text):
    # Python before 3.11 (macOS /usr/bin/python3 is 3.9) does not accept GitHub's trailing "Z".
    return datetime.fromisoformat(text.replace("Z", "+00:00")) if text else datetime.min.replace(tzinfo=timezone.utc)


def login_of(entry):
    return ((entry or {}).get("login")) or ""


def approved_by(raw, me):
    """The latest verdict by `me` is an approval; plain comments do not change a verdict."""
    verdicts = [r["state"] for r in raw.get("reviews") or [] if login_of(r.get("author")) == me
                and r["state"] in ("APPROVED", "CHANGES_REQUESTED", "DISMISSED")]
    return bool(verdicts) and verdicts[-1] == "APPROVED"


def facts_of(raw, me, ignore):
    """The frontmatter values of an open PR, comments aside."""
    checks = raw.get("statusCheckRollup")
    approval = {"APPROVED": "approved", "CHANGES_REQUESTED": "changes_requested", "REVIEW_REQUIRED": "review_required"}
    merge = {"MERGEABLE": "mergeable", "CONFLICTING": "conflicting"}
    return {
        "pr_state": "open",
        "pr_ci": ci_of(checks),
        "pr_ci_fix": ci_of(checks, ignore),
        "pr_ci_failed": ",".join(failed_checks(checks)),
        "pr_merge": merge.get(raw.get("mergeable"), "unknown"),
        "pr_approval": approval.get(raw.get("reviewDecision"), "none"),
        "pr_approved_by_me": "true" if approved_by(raw, me) else "false",
        "pr_draft": "true" if raw.get("isDraft") else "false",
        "pr_head": raw.get("headRefOid") or "",
    }


def asks_for_change(author, body, me, inline, reply):
    """My own comment with @change or as a new inline thread (a reply is conversation); any
    comment by someone else, bots included (a review bot's findings are a top-level comment).
    The fixer decides which of them need a change."""
    if author == me:
        return "@change" in body or (inline and not reply)
    return True


def review_comments(raw, me):
    """Reviews that ask for a change, as review-<id>: every changes-requested review, anyone
    else's commented review with text (a QA report, say), and my own with @change."""
    ids = []
    for r in raw.get("reviews") or []:
        author, body, state = login_of(r.get("author")), (r.get("body") or "").strip(), r.get("state")
        if state == "CHANGES_REQUESTED" or (author and body and state == "COMMENTED" and (author != me or "@change" in body)):
            ids.append(f"review-{r['id']}")
    return ids


def graphql(query):
    """The data of a GraphQL query and the messages of its partial errors (a missing PR, say)."""
    result = subprocess.run([os.environ.get("WORKITEM_GH", "gh"), "api", "graphql", "-f", f"query={query}"],
                            capture_output=True, text=True, timeout=60)
    try:
        body = json.loads(result.stdout or "{}")
    except ValueError:
        body = {}
    errors = [e.get("message", "") for e in body.get("errors") or []]
    if not body.get("data"):
        raise RuntimeError("; ".join(errors) or result.stderr.strip() or f"gh exited with {result.returncode}")
    return body["data"], errors


def read_pulls(urls, fields):
    """The `fields` of each PR, CHUNK PRs of a repo per query: ({url: node or error}, my login)."""
    by_repo = {}
    for url in urls:
        owner, repo, _, number = url.rstrip("/").split("/")[-4:]
        by_repo.setdefault((owner, repo), {})[int(number)] = url
    found, me = {}, None
    for (owner, repo), prs in by_repo.items():
        numbers = sorted(prs)
        for chunk in (numbers[i:i + CHUNK] for i in range(0, len(numbers), CHUNK)):
            pulls = " ".join(f"p{n}: pullRequest(number: {n}) {{ {fields.replace('NUMBER', str(n))} }}" for n in chunk)
            query = (f"query {{ viewer {{ login }} repository(owner: {json.dumps(owner)}, name: {json.dumps(repo)}) "
                     f"{{ {pulls} }} }}")
            try:
                data, errors = graphql(query)
            except (RuntimeError, subprocess.TimeoutExpired) as e:
                found.update({prs[n]: e for n in chunk})
                continue
            me = data["viewer"]["login"]
            for n in chunk:
                node = (data.get("repository") or {}).get(f"p{n}")
                found[prs[n]] = node or RuntimeError("; ".join(errors) or "no such PR")
    return found, me


def read_open_pulls(urls):
    """GitHub says UNKNOWN while it computes mergeability; asking again a moment later helps."""
    pulls, me = read_pulls(urls, PULL_FIELDS)
    for _ in range(UNKNOWN_RETRIES):
        computing = [u for u, n in pulls.items() if isinstance(n, dict) and n["state"] == "OPEN" and n["mergeable"] == "UNKNOWN"]
        if not computing:
            break
        time.sleep(UNKNOWN_RETRY_WAIT)
        again, _ = read_pulls(computing, PULL_FIELDS)
        pulls.update({u: n for u, n in again.items() if isinstance(n, dict)})
    return pulls, me


def view_of(pull):
    """A PULL_FIELDS node with its connections as plain lists, the checks of the head commit."""
    commits = pull["commits"]["nodes"]
    rollup = commits[0]["commit"].get("statusCheckRollup") if commits else None
    return {**pull, "statusCheckRollup": rollup["contexts"]["nodes"] if rollup else [],
            "comments": pull["comments"]["nodes"], "reviews": pull["reviews"]["nodes"]}


def inline_comments(threads, me):
    """Ids of the inline review comments (a THREAD_FIELDS node) that ask for a change."""
    ids = []
    for thread in threads["reviewThreads"]["nodes"]:
        for c in thread["comments"]["nodes"]:
            author = login_of(c.get("author"))
            if author and asks_for_change(author, c.get("body") or "", me, True, c.get("replyTo") is not None):
                ids.append(f"inline-{c['databaseId']}")
    return ids


def change_comments(raw, me):
    """Ids of the PR-level comments and reviews that ask for a change."""
    ids = [c["id"] for c in raw.get("comments") or []
           if login_of(c.get("author")) and asks_for_change(login_of(c["author"]), c.get("body") or "", me, False, False)]
    return ids + review_comments(raw, me)


def updates_of(pull, threads, fields, me, ignore):
    """The frontmatter of one PR. `threads` is None when the PR has not moved since the last
    reading; the inline comments still unseen then stay so."""
    for found in (pull, threads):
        if isinstance(found, Exception):
            raise found
    if pull["state"] in ("MERGED", "CLOSED"):
        return {"pr_state": pull["state"].lower()}
    if pull["state"] != "OPEN":
        raise RuntimeError(f"unknown PR state {pull['state']}")
    raw = view_of(pull)
    if threads is None:
        inline = [i for i in id_list(fields.get("pr_unseen_comments")) if i.startswith("inline-")]
    else:
        inline = inline_comments(threads, me)
    return {**facts_of(raw, me, ignore), "pr_ci_required": ci_of([c for c in raw["statusCheckRollup"] if c.get("isRequired")]),
            "pr_activity_at": activity_of(pull), "pr_updated_at": pull["updatedAt"],
            **comment_updates(fields, inline + change_comments(raw, me))}


def id_list(value):
    return [i for i in (value or "").split(",") if i]


def comment_updates(fields, comments):
    """pr_seen_comments and pr_unseen_comments for the comments now on the PR. An old
    pr_handled_review (a changes-requested review a fixer already had) counts as seen."""
    updates = {}
    seen = None if "pr_seen_comments" not in fields else id_list(fields["pr_seen_comments"])
    if fields.get("pr_handled_review"):
        seen = (seen or []) + [f"review-{fields['pr_handled_review']}"]
        updates["pr_handled_review"] = None
    if seen is None:
        seen = list(comments)
    updates["pr_seen_comments"] = ",".join(seen)
    updates["pr_unseen_comments"] = ",".join(c for c in comments if c not in seen)
    return updates


def changed(fields, updates):
    return {k: v for k, v in updates.items() if fields.get(k) != v and not (v is None and k not in fields)}


def awaits_reading(fields):
    """pr-review acts after a fixer only on a reading newer than the fixer's end."""
    ended = fields.get("pr_fix_ended_at", "")
    return bool(ended) and fields.get("pr_checked_at", "") <= ended


def now():
    """UTC with milliseconds; pr-status and pr-review compare these as text."""
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def write(path, fields, pr, updates):
    updates = changed(fields, {"pr_url": pr, **updates})
    stamp = now()
    if updates.get("pr_head") or (fields.get("pr_head") and "pr_head_at" not in fields):
        updates["pr_head_at"] = stamp
    if updates or awaits_reading(fields):
        updates["pr_checked_at"] = stamp
    set_fields(path, updates)


def options_of(argv):
    ignore = ["dockerized", "e2e", "playwright"]
    while argv:
        flag = argv.pop(0)
        if flag == "--ignore":
            ignore = [w for w in argv.pop(0).lower().split(",") if w]
        else:
            sys.exit(f"unknown option {flag}")
    return ignore


def main(argv):
    ignore = options_of(list(argv))
    root = os.environ["WORKITEM_DIR_ROOT"]
    items = []
    for item in json.load(sys.stdin):
        pr = item["pr"]
        if not pr.startswith("http"):
            continue
        path = os.path.join(root, item["dir"], "workitem.md")
        fields = read_fields(path)
        if fields.get("pr_url", pr) != pr:
            set_fields(path, {k: None for k in fields if k.startswith("pr_")})
            fields = read_fields(path)
        elif fields.get("pr_state") == "merged":
            continue
        items.append((item["dir"], path, fields, pr))
    if not items:
        return
    pulls, me = read_open_pulls({pr for *_, pr in items})
    moved = {pr for _, _, fields, pr in items
             if isinstance(pulls[pr], dict) and pulls[pr]["state"] == "OPEN" and fields.get("pr_updated_at") != pulls[pr]["updatedAt"]}
    threads, _ = read_pulls(moved, THREAD_FIELDS) if moved else ({}, None)
    for name, path, fields, pr in items:
        try:
            updates = updates_of(pulls[pr], threads.get(pr), fields, me, ignore)
        except (RuntimeError, KeyError, TypeError, ValueError, subprocess.TimeoutExpired) as e:
            print(f"cannot read the PR of {name}: {e}", file=sys.stderr)
            continue
        write(path, fields, pr, updates)


if __name__ == "__main__":
    main(sys.argv[1:])
