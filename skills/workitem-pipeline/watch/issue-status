#!/usr/bin/env python3
"""Workspace watcher: copy each item's issue status into its frontmatter.

  issue-status

Writes `issue_status` (e.g. `Waiting for Deployment`) and `issue_status_category` (`new`,
`indeterminate` or `done`). The tracker is the workspace's `issue_tracker` (decision 62); items
whose `issue:` belongs to another tracker are left alone. The file is only written when a value
changed.

Jira: one search per 100 keys (`key in (...)`), whatever the projects of the keys; Jira Cloud only,
with jira-cli's setup: `server` and `login` from its config (`JIRA_CONFIG_FILE`, else
`~/.config/.jira/.config.yml`), and the API token from `JIRA_API_TOKEN`, else `~/.netrc`, else the
OS keyring (service `jira-cli`). Without them it says so once per run and exits 0.

GitHub: one GraphQL query per repo; open is `Open`/`new`, open and assigned `In progress`/
`indeterminate`, closed `Closed`/`done` (decision 65).
"""
import json, os, sys

sys.dont_write_bytecode = True
# The helpers sit next to workitem-move, which the backend names.
sys.path.insert(0, os.path.dirname(os.environ["WORKITEM_MOVE"]) if "WORKITEM_MOVE" in os.environ
                else os.path.join(os.path.dirname(os.path.realpath(__file__)), "../bin"))
import workitem_tracker as tracker  # noqa: E402
from workitem_fields import read_fields, set_fields  # noqa: E402


def main():
    root = os.environ["WORKITEM_DIR_ROOT"]
    try:
        name = tracker.tracker_of(root)
    except tracker.Problem as e:
        print(f"{e}, skipping", file=sys.stderr)
        return
    pattern = tracker.JIRA_KEY if name == "jira" else tracker.GITHUB_REF
    keys = {}
    for item in json.load(sys.stdin):
        key = tracker.issue_key(item["issue"])
        if pattern.fullmatch(key):
            keys.setdefault(key, []).append(item["dir"])
    if not keys:
        return
    try:
        client = tracker.client(name, root)
    except tracker.Problem as e:
        print(f"{e}, skipping", file=sys.stderr)
        return
    found = {}
    sorted_keys = sorted(keys)
    try:
        if name == "jira":
            for start in range(0, len(sorted_keys), tracker.PAGE):
                found.update(client.statuses(sorted_keys[start:start + tracker.PAGE]))
        else:
            found = client.statuses(sorted_keys)
    except (tracker.Problem, RuntimeError, OSError, ValueError, KeyError, TypeError) as e:
        print(f"cannot read issue statuses: {e}", file=sys.stderr)
        return
    for key, (status, category) in found.items():
        for directory in keys[key]:
            path = os.path.join(root, directory, "workitem.md")
            values = {"issue_status": status, "issue_status_category": category}
            try:
                fields = read_fields(path)
                set_fields(path, {k: v for k, v in values.items() if fields.get(k) != v})
            except (RuntimeError, OSError) as e:
                # An item an agent is busy writing waits for the next run; the others are written.
                print(f"{directory}: {e}", file=sys.stderr)


if __name__ == "__main__":
    main()
